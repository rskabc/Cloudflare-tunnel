# Copy this file to .env and paste the tunnel token from Cloudflare Zero Trust.
# Never commit the real .env file or share the tunnel token.
TUNNEL_TOKEN=PASTE_CLOUDFLARE_TUNNEL_TOKEN_HERE

# Exact existing Docker network name shared with Nginx Proxy Manager.
# Find it with: docker inspect <npm-container-name> --format '{{json .NetworkSettings.Networks}}'
NPM_DOCKER_NETWORK=npm_network
